# Database en dashboard
POSTGRES_PASSWORD=maak-een-sterk-wachtwoord
GRAFANA_DB_PASSWORD=maak-een-ander-sterk-wachtwoord
GRAFANA_ADMIN_PASSWORD=maak-nog-een-sterk-wachtwoord
# Eigen leesrol van de API. Leeg laten gebruikt GRAFANA_DB_PASSWORD.
API_DB_PASSWORD=maak-een-vierde-sterk-wachtwoord
# Grafana luistert standaard alleen lokaal. 0.0.0.0 = bereikbaar op het netwerk.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# Meter
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
MODBUS_MODE=TCP
MODBUS_SLAVE=1

# App-API
API_TOKEN=vervang-door-een-lang-willekeurig-token
API_PORT=8000

# Telegram Bot API
# Maak de bot via @BotFather en stuur hem eerst zelf een bericht.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Apple-pushmeldingen (APNs)
# Maak in het Apple Developer-account een sleutel met "Apple Push Notifications
# service (APNs)" en leg het gedownloade bestand in ./secrets.
APNS_KEY_FILE=/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=io.qman.wattnu

# Back-ups: aantal dagen dat dumps in ./backups blijven staan
BACKUP_KEEP_DAYS=7
