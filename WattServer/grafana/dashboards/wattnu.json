    {
      "id": 13,
      "title": "Gemiddeld verbruik per uur en weekdag (kWh)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "wattnu-db"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 14,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "wattnu-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(hour, 'FM00') || ':00' AS \"Uur\", round(avg(kwh_total) FILTER (WHERE dow = 1)::numeric, 3) AS \"Ma\", round(avg(kwh_total) FILTER (WHERE dow = 2)::numeric, 3) AS \"Di\", round(avg(kwh_total) FILTER (WHERE dow = 3)::numeric, 3) AS \"Wo\", round(avg(kwh_total) FILTER (WHERE dow = 4)::numeric, 3) AS \"Do\", round(avg(kwh_total) FILTER (WHERE dow = 5)::numeric, 3) AS \"Vr\", round(avg(kwh_total) FILTER (WHERE dow = 6)::numeric, 3) AS \"Za\", round(avg(kwh_total) FILTER (WHERE dow = 7)::numeric, 3) AS \"Zo\" FROM (SELECT extract(hour FROM bucket AT TIME ZONE 'Europe/Amsterdam')::int AS hour, extract(isodow FROM bucket AT TIME ZONE 'Europe/Amsterdam')::int AS dow, kwh_total FROM energy_hourly WHERE whole_hour AND $__timeFilter(bucket)) h GROUP BY hour ORDER BY hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uur"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Hele uren binnen de laatste 90 dagen, in Nederlandse tijd.",
      "timeFrom": "90d"
    },
